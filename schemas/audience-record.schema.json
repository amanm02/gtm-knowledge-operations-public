{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gtm-brain/schemas/audience-record.schema.json",
  "title": "GTM Brain Audience Record",
  "description": "Defines a reusable buyer, user, customer, account, or segment context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audience_id",
    "name",
    "segment",
    "role",
    "jobs_to_be_done",
    "pain_points",
    "desired_outcomes",
    "objections",
    "success_criteria",
    "evidence_ids",
    "status",
    "owner_role",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "example_notice": {
      "type": "string",
      "const": "ILLUSTRATIVE OUTPUT — PLACEHOLDER CONTENT ONLY"
    },
    "audience_id": {
      "type": "string",
      "pattern": "^(src|evd|aud|ins|clm|msg|ast|rev)_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "segment": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "jobs_to_be_done": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pain_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "desired_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evd_[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "needs_review",
        "retired"
      ]
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
